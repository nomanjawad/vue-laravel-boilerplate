APP_NAME=WebTemplate
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Prefer daily (14-day retention via LOG_DAILY_DAYS) over single so logs
# cannot grow into one giant file on shared hosting. Add ",console" in local
# for color-coded terminal output (skip console in production — ANSI noise).
LOG_STACK=daily,console
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (MySQL only — no SQLite). Production: standard port 3306.
# Local MAMP: DB_PORT=8889, DB_USERNAME/DB_PASSWORD=root. XAMPP: DB_PORT=3306, root with empty password.
# If MAMP socket connection is needed: DB_SOCKET=/Applications/MAMP/tmp/mysql/mysql.sock
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password
# Backups (spatie/laravel-backup): MAMP keeps mysqldump out of PATH.
# DB_DUMP_BINARY_PATH=/Applications/MAMP/Library/bin/mysql80/bin

# Sessions & Cache — database drivers on shared hosting (inode-frugal).
# File sessions/cache fill storage/framework/{sessions,cache/data} without bound.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# Default to database queue so jobs aren't sent synchronously (mail, image
# processing, WP imports). On shared hosting where no long-running worker is
# possible, the scheduler drains the queue every minute via
# `queue:work --stop-when-empty` — see routes/console.php.
QUEUE_CONNECTION=database

CACHE_STORE=database

# Full-page response cache (spatie/laravel-responsecache) for static public
# pages. Disable while actively editing content in dev if it gets in the way.
# Uses the dedicated `responsecache` store → `cache_responses` table so
# ResponseCache::clear() never wipes app caches in `cache`.
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_DRIVER=responsecache

# Mail - Configure for production
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Search engine indexing. Keep false for dev/staging so the site is
# kept out of Google (noindex meta + X-Robots-Tag header + blocking
# robots.txt). Set true in production once the site is ready to be found.
SEO_INDEXABLE=false

# Sentry error monitoring (opt-in). Leave unset to disable — bootstrap/app.php
# guards the reportable hook with class_exists so the app still boots without
# the package installed. For the browser bundle, also set VITE_SENTRY_DSN and
# add @sentry/vue via `pnpm add @sentry/vue`. See README §6.4.
# SENTRY_LARAVEL_DSN=
# VITE_SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Content Security Policy (opt-in). Off by default so a project using GA /
# Stripe / Cloudflare doesn't break on the first enable. Turn REPORT_ONLY on
# first to log violations without blocking, tune config/csp.php's directive
# list, then flip ENABLED on. Nonce-based script-src is baked in.
CSP_ENABLED=false
CSP_REPORT_ONLY=false

# Feature Flags
FEATURE_BLOG=true
FEATURE_CAREERS=false
FEATURE_CASE_STUDIES=false
FEATURE_TEAMS=true
FEATURE_CONTACT_FORM=true

VITE_APP_NAME="${APP_NAME}"

<?php

namespace App\Modules\{{module}}\Http\Controllers\Admin;

use App\Http\Controllers\Controller;
use App\Modules\{{module}}\Http\Requests\Store{{model}}Request;
use App\Modules\{{module}}\Http\Requests\Update{{model}}Request;
use App\Modules\{{module}}\Models\{{model}};
use Illuminate\Http\Request;
use Inertia\Inertia;
use Inertia\Response;

class {{model}}Controller extends Controller
{
    public function index(Request $request): Response
    {
        $this->authorize('viewAny', {{model}}::class);

        return Inertia::render('{{module}}/Admin/{{models}}/Index', [
            '{{plural}}' => {{model}}::query()
                ->when($request->search, fn ($q, $s) => $q->where('title', 'like', "%{$s}%"))
                ->latest()
                ->paginate(20)
                ->withQueryString(),
            'filters' => $request->only('search'),
        ]);
    }

    public function create(): Response
    {
        $this->authorize('create', {{model}}::class);

        return Inertia::render('{{module}}/Admin/{{models}}/Create');
    }

    public function store(Store{{model}}Request $request)
    {
        ${{var}} = {{model}}::create($request->validated());

        return redirect()
            ->route('admin.{{resource}}.edit', ${{var}})
            ->with('success', '{{model}} created.');
    }

    public function edit({{model}} ${{var}}): Response
    {
        $this->authorize('update', ${{var}});

        return Inertia::render('{{module}}/Admin/{{models}}/Edit', [
            '{{var}}' => ${{var}},
        ]);
    }

    public function update(Update{{model}}Request $request, {{model}} ${{var}})
    {
        ${{var}}->update($request->validated());

        return back()->with('success', '{{model}} updated.');
    }

    public function destroy({{model}} ${{var}})
    {
        $this->authorize('delete', ${{var}});

        ${{var}}->delete();

        return redirect()
            ->route('admin.{{resource}}.index')
            ->with('success', '{{model}} deleted.');
    }
}
